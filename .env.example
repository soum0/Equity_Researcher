# ============================================================
# AI Financial Analysis Pipeline — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ============================================================

# ── Step 1: Data Ingestion ───────────────────────────────────

# Finnhub — company profile, real-time quotes, news, SEC filings
# Get free key at: https://finnhub.io  (60 calls/min free)
FINNHUB_API_KEY=your_finnhub_api_key_here

# NewsAPI — headline news articles
# Get free key at: https://newsapi.org  (100 calls/day free)
NEWSAPI_KEY=your_newsapi_key_here

# FRED (Federal Reserve Economic Data) — macro indicators
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html  (unlimited free)
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR — no sign-up needed, just identify yourself in the User-Agent header
# Format: "Your Name your@email.com"
SEC_USER_AGENT=Your Name your@email.com

# ── Step 2–6: LLM (Entity Extraction + Agents) ───────────────

# OpenRouter — access free LLMs via OpenAI-compatible API
# Get free key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Model to use for entity extraction and all agents
# Recommended options (all free on OpenRouter):
#
#   google/gemini-2.0-flash-exp:free      — fastest (~4s total extraction)
#   meta-llama/llama-3.2-3b-instruct:free — fast + lightweight (~8s)
#   mistralai/mistral-7b-instruct:free    — good quality/speed balance (~16s)
#   meta-llama/llama-3.3-70b-instruct     — best quality, slowest (~60s)
#
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── Optional Tuning ──────────────────────────────────────────

# How many days of news to fetch (default: 30)
NEWS_LOOKBACK_DAYS=30

# How many SEC filings to download per ticker (default: 3)
# Covers ~3 years of 10-K filings
MAX_SEC_FILINGS=3
